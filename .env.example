# Токен бота от @BotFather
BOT_TOKEN=
# Публичный HTTPS-адрес мини-аппа (например https://sellers-place.example.com)
WEBAPP_URL=
# Канал, куда бот публикует посты (бот должен быть админом с правом публикации)
CHANNEL_ID=@sellersplace2
CHANNEL_USERNAME=sellersplace2
# Telegram user id модераторов через запятую (узнать свой id: @userinfobot)
ADMIN_IDS=
ADS_CONTACT=ranjiroakim
GARANT_CONTACT=ranjiroakim
# true — публиковать без модерации
AUTO_PUBLISH=false
PORT=3000
DATA_DIR=./data

# Стоимость размещения (0 — бесплатно). Оплату принимает администратор в личных сообщениях Telegram
POST_PRICE=150
# @username администратора, которому клиенты пишут для оплаты
PAYMENT_CONTACT=ranjiroakim
